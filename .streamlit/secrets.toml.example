# Copy to .streamlit/secrets.toml for a local Supabase test, and paste the same keys into the
# Streamlit Community Cloud app's Secrets box for deployment.
# NEVER commit the real file: .streamlit/secrets.toml is gitignored.

ANTHROPIC_API_KEY = "sk-ant-api03-replace-me"
ANTHROPIC_MODEL = "claude-haiku-4-5-20251001"
ANTHROPIC_AGENT_MODEL = "claude-haiku-4-5-20251001"

# local = JSON files in data/ (development). supabase = shared workspace (deployment).
STORAGE_BACKEND = "supabase"

# Supabase project settings -> API. Use the SERVICE ROLE key, never the anon key: Row Level
# Security is enabled with no policies, so only the service-role key can reach the data. This key
# is used server-side only and must never be exposed to a browser.
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY = "replace-with-service-role-key"

# The single password gating the whole app. Generate 20+ random characters.
APP_PASSWORD = "replace-with-a-20-character-random-password"

# Daily caps. These bound what the shared link can cost.
DAILY_REPORT_LIMIT = 20
DAILY_AGENT_LIMIT = 5
DAILY_SPEND_LIMIT_USD = 2.00
APP_TIMEZONE = "America/Toronto"

MAX_FILE_MB = 5
MAX_PAGES = 50
MAX_CHUNKS_PER_REPORT = 6
